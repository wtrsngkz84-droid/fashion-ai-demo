.tab-bar{position:fixed;bottom:0;left:0;right:0;display:flex;background:#fff;border-top:1rpx solid #E8E4E0;padding:16rpx 0 calc(16rpx + env(safe-area-inset-bottom));color:#8A8690;z-index:20;}
.tab{flex:1;display:flex;flex-direction:column;align-items:center;gap:4rpx;font-size:22rpx;}.icon{font-size:42rpx;}.active{color:#C2705A;}.dark{background:#252329;border-color:#3D3A42;}.dark .active{color:#D48A7A;}
