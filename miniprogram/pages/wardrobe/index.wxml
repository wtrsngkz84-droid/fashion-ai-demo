<view class="screen {{dark ? 'dark' : ''}}">
  <view class="card row"><view class="stat"><view class="stat-num">{{filtered.length}}</view><view class="stat-label">{{filter}}</view></view><view class="stat"><view class="stat-num">{{clean}}</view><view class="stat-label">可穿</view></view><view class="stat"><view class="stat-num">{{dirty}}</view><view class="stat-label">待洗</view></view><button class="secondary small" bindtap="toggleEdit">{{edit ? '取消' : '✏️ 编辑'}}</button></view>
  <view class="chips"><button wx:for="{{filters}}" wx:key="*this" class="chip {{filter === item ? 'active' : ''}}" data-value="{{item}}" bindtap="filter">{{item}}</button></view>
  <view wx:if="{{error && !formOpen}}" class="error">{{error}}<button bindtap="load" class="small secondary">重试</button></view><view wx:if="{{busy}}" class="notice">正在加载…</view>
  <view wx:if="{{!filtered.length && !busy && !error}}" class="empty"><view class="empty-icon">👗</view><view class="title">{{items.length ? '该分类下暂无衣物' : '衣橱是空的'}}</view><view>点击右下角＋按钮添加衣物</view></view>
  <view class="grid"><view wx:for="{{filtered}}" wx:key="id" class="garment"><view class="swatch" style="background:{{item.color_hex}}"><text class="garment-icon">{{item.category === '鞋子' ? '👟' : item.category === '下装' ? '👖' : '👕'}}</text><text class="color-label">{{item.color}}</text></view><view class="info"><view class="muted">{{item.brand}}</view><view>{{item.name}}</view><view class="row between muted spaced"><text>{{item.category}}</text><text>{{item.statusLabel}}</text></view><view wx:if="{{edit}}" class="actions"><button class="small secondary" data-id="{{item.id}}" data-status="{{item.status}}" bindtap="status">{{item.status === 'clean' ? '标待洗' : '标可穿'}}</button><button class="small danger" data-id="{{item.id}}" bindtap="remove">删除</button></view></view></view></view>
  <button class="fab" bindtap="openForm" aria-label="添加衣物">＋</button>
  <view wx:if="{{formOpen}}" class="overlay"><view class="modal"><scroll-view scroll-y class="modal-scroll"><view class="title">添加衣物</view><view class="notice">拍照辅助分析或手动录入，确认后才会入库。</view><view wx:if="{{error}}" class="error">{{error}}</view><button class="secondary" bindtap="photo" disabled="{{busy}}">📷 拍照 / 从相册选择</button><image wx:if="{{photo}}" src="{{photo}}" class="preview" mode="aspectFit"/><view wx:if="{{visionNote}}" class="notice">{{visionNote}}</view><view class="label spaced">名称</view><input value="{{form.name}}" data-field="name" bindinput="field" placeholder="例如：白色棉质T恤" maxlength="80"/><view class="label">类别</view><picker range="{{categories}}" bindchange="category"><view class="picker">{{form.category}} ▾</view></picker><view class="label">颜色名称 / 色值</view><input value="{{form.color}}" data-field="color" bindinput="field" maxlength="80"/><input value="{{form.color_hex}}" data-field="color_hex" bindinput="field" maxlength="7"/><view class="label">品牌（选填）</view><input value="{{form.brand}}" data-field="brand" bindinput="field" maxlength="80"/><view class="label">标签（逗号分隔，最多12个）</view><input value="{{tagsText}}" bindinput="tags" placeholder="通勤,简约" maxlength="160"/><view class="actions"><button bindtap="closeForm" disabled="{{busy}}">取消</button><button class="primary" bindtap="submit" loading="{{busy}}" disabled="{{busy}}">确认入库</button></view></scroll-view></view></view>
</view>
