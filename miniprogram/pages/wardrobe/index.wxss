.grid{display:flex;flex-wrap:wrap;gap:20rpx;}.garment{width:calc(50% - 10rpx);background:var(--bg2);border-radius:24rpx;overflow:hidden;box-shadow:0 2rpx 6rpx rgba(45,42,50,.06);}.swatch{height:240rpx;position:relative;display:flex;align-items:center;justify-content:center;}.garment-icon{font-size:100rpx;}.color-label{position:absolute;bottom:12rpx;left:12rpx;background:rgba(255,255,255,.9);color:#2D2A32;font-size:22rpx;border-radius:16rpx;padding:4rpx 12rpx;}.info{padding:20rpx;}.info .actions{flex-wrap:wrap;}.info .actions button{padding:8rpx;font-size:22rpx;}.preview{width:100%;height:240rpx;margin-top:20rpx;}
