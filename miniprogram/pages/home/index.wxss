.home{padding-bottom:calc(300rpx + env(safe-area-inset-bottom));}.dashboard{border-bottom:2rpx solid var(--rule);padding:0 8rpx 20rpx;}.bubble{background:var(--bg2);padding:24rpx;border-radius:8rpx 28rpx 28rpx 28rpx;margin:24rpx 0;line-height:1.7;}.input-row{position:fixed;bottom:calc(124rpx + env(safe-area-inset-bottom));left:0;right:0;padding:8rpx 24rpx;background:var(--bg);z-index:10;}.input-row input{border-radius:40rpx;}.outfit .actions button{padding:16rpx 8rpx;font-size:24rpx;}
