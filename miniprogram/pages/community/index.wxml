<view class="screen {{dark ? 'dark' : ''}}"><view class="center"><view class="title">👥 穿搭社区</view><view class="muted">分享你的穿搭灵感，发现更多搭配思路</view><button class="primary spaced" bindtap="open">📸 发布穿搭</button><view class="notice">当前为本机草稿与演示内容，尚未公开发布。</view></view><view wx:for="{{posts}}" wx:key="id" class="card"><view class="row"><view class="avatar">👤</view><view class="grow"><view>{{item.user}}</view><view class="muted">{{item.sample ? '演示内容' : '仅保存在本机'}}</view></view><button wx:if="{{item.mine}}" class="link danger" data-id="{{item.id}}" bindtap="remove">删除</button></view><view class="spaced content">{{item.content}}</view><view class="tag spaced">🎨 {{item.outfit}}</view><view class="row spaced"><button class="link" data-id="{{item.id}}" data-field="liked" bindtap="react">{{item.liked ? '❤️ 已喜欢' : '🤍 喜欢'}}</button><button class="link" data-id="{{item.id}}" data-field="collected" bindtap="react">{{item.collected ? '⭐ 已收藏' : '☆ 收藏'}}</button></view></view><view wx:if="{{open}}" class="overlay"><view class="modal"><view class="title">发布穿搭</view><view class="notice">此阶段仅保存本机草稿</view><textarea value="{{content}}" bindinput="input" maxlength="300" placeholder="说说你的穿搭心得..."/><view class="actions"><button bindtap="close">取消</button><button class="primary" bindtap="save">保存草稿</button></view></view></view></view>
