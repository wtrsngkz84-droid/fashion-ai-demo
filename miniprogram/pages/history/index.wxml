<view class="screen {{dark ? 'dark' : ''}}"><view class="card row"><view class="stat"><view class="stat-num">{{items.length}}</view><view class="stat-label">全部记录</view></view><view class="muted">已保存的穿搭</view></view><view class="chips"><button wx:for="{{filters}}" wx:key="id" class="chip {{filter === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="filter">{{item.label}}</button></view><view wx:if="{{error}}" class="error">{{error}}<button bindtap="load" class="secondary small">重试</button></view><view wx:if="{{busy}}" class="notice">正在加载…</view><view wx:if="{{!filtered.length && !busy && !error}}" class="empty"><view class="empty-icon">📅</view><view class="title">{{items.length ? '该分类下暂无记录' : '还没有穿搭记录'}}</view><view>去首页让AI帮你搭配一套吧</view><button class="primary spaced" bindtap="home">去首页看看</button></view><view wx:for="{{filtered}}" wx:key="id"><view class="muted">{{item.date}}</view><view class="card row"><view class="history-icon">👔</view><view class="grow"><view class="section-title">{{item.outfit.name}}</view><view class="muted">{{item.label}}</view><view class="muted">{{item.outfit.reason}}</view></view><button class="link danger" data-id="{{item.id}}" bindtap="remove">✕</button></view></view></view>
