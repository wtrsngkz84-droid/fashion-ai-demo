/* Tokens and proportions adapted from this repository's styles.css (375px -> 750rpx). */
page{background:#FDF8F6;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;font-size:28rpx;color:#2D2A32;}
.screen{--bg:#FDF8F6;--bg2:#fff;--ink:#2D2A32;--muted:#8A8690;--rule:#E8E4E0;--accent:#C2705A;--accent-light:#F5E6E0;box-sizing:border-box;min-height:100vh;background:var(--bg);color:var(--ink);padding:24rpx 24rpx calc(160rpx + env(safe-area-inset-bottom));}
.screen.dark{--bg:#1A181F;--bg2:#252329;--ink:#E8E4E0;--muted:#AAA5B0;--rule:#3D3A42;--accent:#D48A7A;--accent-light:#3D2A25;}
view,button,input,textarea{box-sizing:border-box;}button{margin:0;font-size:26rpx;line-height:1.5;padding:16rpx 24rpx;border-radius:40rpx;background:var(--bg2);color:var(--ink);}button::after{border:none;}button[disabled]{opacity:.5;}
.primary{background:var(--accent);color:#fff;}.secondary{border:2rpx solid var(--rule);}.small{padding:8rpx 20rpx;font-size:24rpx;}.link{color:var(--accent);background:transparent;padding:4rpx 8rpx;}.danger{color:#B13838;}
.card{background:var(--bg2);border-radius:32rpx;padding:28rpx;margin-bottom:20rpx;box-shadow:0 2rpx 6rpx rgba(45,42,50,.06);}.row{display:flex;align-items:center;gap:16rpx;}.between{justify-content:space-between;}.grow{flex:1;min-width:0;}.wrap{flex-wrap:wrap;}.muted{color:var(--muted);font-size:24rpx;line-height:1.7;}.title{font-size:34rpx;font-weight:700;}.section-title{font-size:28rpx;font-weight:600;margin-bottom:16rpx;}.center{text-align:center;}.spaced{margin-top:20rpx;}.empty{text-align:center;padding:100rpx 24rpx;color:var(--muted);}.empty-icon{font-size:80rpx;margin-bottom:20rpx;}.empty .title{color:var(--ink);margin-bottom:12rpx;}
.error{padding:20rpx;background:#FFF0F2;color:#9C3030;border-radius:16rpx;margin-bottom:16rpx;font-size:26rpx;}.notice{font-size:24rpx;color:var(--muted);padding:16rpx 0;line-height:1.6;}.chips{display:flex;flex-wrap:wrap;gap:12rpx;margin:16rpx 0;}.chip{padding:10rpx 22rpx;border-radius:32rpx;border:2rpx solid var(--rule);font-size:24rpx;}.chip.active{background:var(--accent);color:white;border-color:var(--accent);}
input,textarea,.picker{width:100%;background:var(--bg2);color:var(--ink);border:2rpx solid var(--rule);border-radius:20rpx;padding:18rpx 24rpx;font-size:28rpx;margin:12rpx 0;min-height:80rpx;}textarea{height:160rpx;}.label{font-size:24rpx;color:var(--muted);}.stat{flex:1;text-align:center;}.stat-num{font-size:40rpx;font-weight:700;color:var(--accent);}.stat-label{font-size:22rpx;color:var(--muted);}.tag{display:inline-block;background:var(--accent-light);color:var(--accent);border-radius:24rpx;padding:8rpx 20rpx;font-size:24rpx;}
.overlay{position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:30;display:flex;align-items:center;justify-content:center;}.modal{width:90%;max-height:80vh;background:var(--bg2);border-radius:32rpx;padding:32rpx;}.modal-scroll{height:65vh;}.actions{display:flex;gap:16rpx;margin-top:24rpx;}.actions button{flex:1;}.fab{position:fixed;right:40rpx;bottom:calc(180rpx + env(safe-area-inset-bottom));width:104rpx;height:104rpx;border-radius:52rpx;background:var(--accent);color:white;font-size:60rpx;padding:0;line-height:104rpx;box-shadow:0 8rpx 32rpx rgba(45,42,50,.12);}
